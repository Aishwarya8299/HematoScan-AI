# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Hematoscan
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Security (generate a strong secret for production) ───────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=hematoscan
MONGODB_SERVER_SELECTION_TIMEOUT_MS=1500

# ── CORS (comma-separated origins; frontend dev server) ──────────────────────
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5501","http://127.0.0.1:5501","http://localhost:3000"]

# ── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=backend/uploads

# ── ML model paths (add .h5 files when training completes) ─────────────────────
GATEKEEPER_MODEL_PATH=backend/models/gatekeeper_model.h5
LEUKEMIA_MODEL_PATH=backend/models/leukemia_classifier_model.h5
ML_MODELS_ENABLED=true
GATEKEEPER_VALID_THRESHOLD=0.5
GATEKEEPER_POSITIVE_IS_VALID=true
